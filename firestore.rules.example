// Copy this file to firestore.rules and list your family's Google accounts.
// firestore.rules is git-ignored so the addresses stay out of the public repo.

rules_version = '2';

// Hearth - who may read and write the family's data.
//
// Only signed-in Google accounts on the list below get in. Everything else in
// the database is closed. The web apiKey in cloud.js is public by design;
// these rules are what actually protect the data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'parent-one@gmail.com',
          'parent-two@gmail.com'
        ];
    }

    // kids, tasks, events, rewards, redemptions, exceptions, settings
    match /families/main {
      allow read, write: if isFamily();

      // one document of ticks per month, e.g. days/2026-09.
      // Read is split from write on purpose: the app listens to the whole
      // collection, and a query has no single {month} to match a pattern
      // against, so any condition using the wildcard would deny the listen.
      match /days/{month} {
        allow read: if isFamily();
        allow write: if isFamily() && month.matches('^[0-9]{4}-[0-9]{2}$');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
